# Copia este archivo como .env.local y completa los valores.

# URL pública del sitio (se usa para SEO: sitemap, Open Graph y URL canónica).
NEXT_PUBLIC_SITE_URL=https://www.tu-dominio.com

# URL de un webhook que recibirá las solicitudes de cita en formato JSON (POST).
# Ejemplos: Make, Zapier, n8n, Google Apps Script o tu propio backend.
# Si se deja vacío, el formulario NO envía nada: ofrece al cliente enviar la
# solicitud por WhatsApp con los datos ya escritos.
RESERVAS_WEBHOOK_URL=
